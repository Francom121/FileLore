<Window x:Class="FileLore.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="560" Height="680" MinWidth="480" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="#FAFAF8" FontFamily="Segoe UI" FontSize="13"
        AllowDrop="True" DragOver="Window_DragOver" Drop="Window_Drop"
        Title="FileLore">
  <Window.Resources>
    <Style x:Key="BaseButton" TargetType="Button">
      <Setter Property="Padding" Value="14,7"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="7" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter Property="Opacity" Value="0.85"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="AccentBtn" TargetType="Button" BasedOn="{StaticResource BaseButton}">
      <Setter Property="Background" Value="#EB961E"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style x:Key="GhostBtn" TargetType="Button" BasedOn="{StaticResource BaseButton}">
      <Setter Property="Background" Value="White"/>
      <Setter Property="Foreground" Value="#444444"/>
      <Setter Property="BorderBrush" Value="#DDDDD6"/>
      <Setter Property="BorderThickness" Value="1"/>
    </Style>
    <Style x:Key="DangerBtn" TargetType="Button" BasedOn="{StaticResource BaseButton}">
      <Setter Property="Background" Value="White"/>
      <Setter Property="Foreground" Value="#C0392B"/>
      <Setter Property="BorderBrush" Value="#E5B7B0"/>
      <Setter Property="BorderThickness" Value="1"/>
    </Style>
  </Window.Resources>

  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- Header: file icon, name, parent folder -->
    <Border Grid.Row="0" Padding="14" CornerRadius="10" Background="White" BorderBrush="#ECECE6" BorderThickness="1">
      <StackPanel Orientation="Horizontal">
        <Image x:Name="FileIcon" Width="36" Height="36"/>
        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
          <TextBlock x:Name="FileNameText" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="640"/>
          <TextBlock x:Name="FolderText" Foreground="#8A8A84" FontSize="12" TextTrimming="CharacterEllipsis" MaxWidth="640"/>
        </StackPanel>
      </StackPanel>
    </Border>

    <!-- Unsupported-location banner (network shares, non-NTFS volumes) -->
    <Border Grid.Row="1" x:Name="UnsupportedBanner" Visibility="Collapsed" Margin="0,10,0,0"
            Padding="12,10" CornerRadius="10" Background="#FDF3E3" BorderBrush="#EB961E" BorderThickness="1">
      <StackPanel Orientation="Horizontal">
        <TextBlock Text="⚠" FontSize="14" Foreground="#B07417" VerticalAlignment="Top" Margin="0,1,0,0"/>
        <TextBlock x:Name="UnsupportedText" TextWrapping="Wrap" FontSize="12.5" Foreground="#7A5410"
                   Margin="8,0,0,0" Width="640"/>
      </StackPanel>
    </Border>

    <!-- Content: media pane (left) + note controls (right), like the Mac editor -->
    <Grid Grid.Row="2" Margin="0,14,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition x:Name="MediaColumn" Width="0"/>
        <ColumnDefinition x:Name="NoteColumn" Width="*"/>
      </Grid.ColumnDefinitions>

      <!-- ============ MEDIA PANE ============ -->
      <Grid Grid.Column="0" x:Name="MediaPane" Visibility="Collapsed" Margin="0,0,16,0">
        <!-- video / audio -->
        <Grid x:Name="VideoPane" Visibility="Collapsed">
          <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <Border CornerRadius="10" Background="#17140F" ClipToBounds="True">
            <Grid>
              <MediaElement x:Name="Media" LoadedBehavior="Manual"
                            Stretch="Uniform" MediaOpened="Media_MediaOpened" MediaFailed="Media_MediaFailed"
                            MediaEnded="Media_MediaEnded"/>
              <StackPanel x:Name="AudioArt" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center">
                <Image x:Name="AudioIcon" Width="72" Height="72" Opacity="0.85"/>
                <TextBlock Text="Audio" Foreground="#BDBDB4" FontSize="12" HorizontalAlignment="Center" Margin="0,8,0,0"/>
              </StackPanel>
            </Grid>
          </Border>
          <Border Grid.Row="1" Margin="0,8,0,0" Padding="10,8" CornerRadius="10" Background="White"
                  BorderBrush="#ECECE6" BorderThickness="1">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <Button x:Name="PlayPauseBtn" Content="⏵" FontSize="15" Width="34" Height="30" Padding="0"
                      Style="{StaticResource GhostBtn}" Click="PlayPause_Click"/>
              <StackPanel Grid.Column="1" Margin="10,0" VerticalAlignment="Center">
                <Slider x:Name="SeekSlider" Minimum="0" Maximum="100" Value="0"
                        PreviewMouseLeftButtonDown="Seek_Down" PreviewMouseLeftButtonUp="Seek_Up"/>
                <TextBlock x:Name="TimeText" Text="0:00" FontSize="11" Foreground="#8A8A84" Margin="2,2,0,0"/>
              </StackPanel>
              <Slider Grid.Column="2" x:Name="VolumeSlider" Width="64" Minimum="0" Maximum="1" Value="0.8"
                      VerticalAlignment="Center" ValueChanged="Volume_Changed" ToolTip="Volume"/>
            </Grid>
          </Border>
        </Grid>

        <!-- image (aspect fit) -->
        <Border x:Name="ImagePane" Visibility="Collapsed" CornerRadius="10" Background="#17140F" ClipToBounds="True">
          <Image x:Name="ImageView" Stretch="Uniform"/>
        </Border>

        <!-- shell thumbnail fallback (PSD and other WIC-unsupported formats) -->
        <Border x:Name="ThumbPane" Visibility="Collapsed" CornerRadius="10" Background="White"
                BorderBrush="#ECECE6" BorderThickness="1">
          <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <Image x:Name="ThumbView" Width="256" Height="256" Stretch="Uniform"/>
            <TextBlock x:Name="ThumbLabel" Foreground="#8A8A84" FontSize="12" HorizontalAlignment="Center"
                       Margin="0,10,0,0" Text="Preview (thumbnail)"/>
          </StackPanel>
        </Border>

        <!-- big icon fallback (PDF and other non-media files) -->
        <Border x:Name="IconPane" Visibility="Collapsed" CornerRadius="10" Background="White"
                BorderBrush="#ECECE6" BorderThickness="1">
          <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="20">
            <Image x:Name="BigIcon" Width="96" Height="96"/>
            <TextBlock x:Name="IconLabel" Foreground="#8A8A84" FontSize="12" HorizontalAlignment="Center"
                       Margin="0,12,0,0" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="220"/>
          </StackPanel>
        </Border>
      </Grid>

      <!-- ============ NOTE CONTROLS ============ -->
      <Grid Grid.Column="1">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Template + Export row -->
        <DockPanel Grid.Row="0" Margin="0,0,0,10">
          <Button Content="Export…" Style="{StaticResource GhostBtn}" DockPanel.Dock="Right"
                  Click="Export_Click" Padding="10,4" FontSize="12" Margin="6,0,0,0"/>
          <ComboBox x:Name="TemplateCombo" FontSize="12" Padding="8,4" MinWidth="150"
                    SelectionChanged="TemplateCombo_SelectionChanged"/>
        </DockPanel>

        <TextBlock Grid.Row="1" Text="Note" Foreground="#8A8A84" FontSize="12" FontWeight="SemiBold" Margin="2,0,0,6"/>

        <!-- Note body -->
        <Border Grid.Row="2" CornerRadius="10" Background="White" BorderBrush="#ECECE6" BorderThickness="1">
          <Grid>
            <TextBlock x:Name="BodyHint" Text="Write a note about this file…" Foreground="#BDBDB4"
                       Margin="14,13,0,0" IsHitTestVisible="False"/>
            <TextBox x:Name="BodyBox" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                     BorderThickness="0" Background="Transparent" Padding="12" FontSize="14"
                     VerticalContentAlignment="Top" TextChanged="BodyBox_TextChanged"/>
          </Grid>
        </Border>

        <TextBlock Grid.Row="3" Text="Tags" Foreground="#8A8A84" FontSize="12" FontWeight="SemiBold" Margin="2,12,0,6"/>

        <!-- Tag pills + entry -->
        <Border Grid.Row="4" Padding="10,8,10,4" CornerRadius="10" Background="White" BorderBrush="#ECECE6" BorderThickness="1">
          <StackPanel>
            <WrapPanel x:Name="PillsPanel"/>
            <Grid Margin="0,2,0,4">
              <TextBlock x:Name="TagHint" Text="Add a tag and press Enter" Foreground="#BDBDB4"
                         Margin="3,0,0,0" IsHitTestVisible="False"/>
              <TextBox x:Name="TagInput" BorderThickness="0" Background="Transparent" FontSize="13"
                       KeyDown="TagInput_KeyDown" TextChanged="TagInput_TextChanged"/>
            </Grid>
          </StackPanel>
        </Border>

        <!-- Linked files header + add -->
        <DockPanel Grid.Row="5" Margin="2,12,0,6">
          <Button Content="Add files…" Style="{StaticResource GhostBtn}" DockPanel.Dock="Right"
                  Click="AddFiles_Click" Padding="10,3" FontSize="11.5"/>
          <TextBlock Text="Linked files" Foreground="#8A8A84" FontSize="12" FontWeight="SemiBold"
                     VerticalAlignment="Center"/>
        </DockPanel>

        <!-- Linked file rows -->
        <Border Grid.Row="6" x:Name="LinksBorder" CornerRadius="10" Background="White"
                BorderBrush="#ECECE6" BorderThickness="1" Padding="6,4">
          <StackPanel>
            <TextBlock x:Name="LinksHint" Text="Drop files here to link them — reference photos, scripts, anything."
                       Foreground="#BDBDB4" FontSize="12" Margin="8,4" TextWrapping="Wrap"/>
            <ScrollViewer MaxHeight="168" VerticalScrollBarVisibility="Auto">
              <StackPanel x:Name="LinksPanel"/>
            </ScrollViewer>
          </StackPanel>
        </Border>

        <!-- Actions -->
        <WrapPanel Grid.Row="7" Margin="0,16,0,0" Orientation="Horizontal">
          <Button x:Name="SaveBtn" Content="Save Note" Style="{StaticResource AccentBtn}" Click="Save_Click" Margin="0,0,8,8"/>
          <Button x:Name="DeleteBtn" Content="Delete Note" Style="{StaticResource DangerBtn}" Visibility="Collapsed" Click="Delete_Click" Margin="0,0,8,8"/>
          <Button Content="Copy" Style="{StaticResource GhostBtn}" Click="Copy_Click" Margin="0,0,8,8"/>
          <Button Content="Open File Location" Style="{StaticResource GhostBtn}" Click="OpenLocation_Click" Margin="0,0,8,8"/>
        </WrapPanel>

        <TextBlock Grid.Row="8" x:Name="StatusText" Margin="2,2,0,0" FontSize="12" Foreground="#2E7D32"/>
      </Grid>
    </Grid>
  </Grid>
</Window>
