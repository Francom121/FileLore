<Window x:Class="FileLore.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="480" Height="560" MinWidth="420" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Background="#FAFAF8" FontFamily="Segoe UI" FontSize="13"
        Title="Settings — FileLore">
  <Grid Margin="22">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <TextBlock Grid.Row="0" Text="Global hotkeys" FontSize="16" FontWeight="SemiBold" Margin="2,0,0,4"/>
    <TextBlock Grid.Row="1" Text="Click a box, then press the key combo you want. Changes apply immediately."
               Foreground="#8A8A84" FontSize="12" Margin="2,0,0,14" TextWrapping="Wrap"/>

    <!-- Hotkey capture boxes -->
    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <StackPanel Margin="0,0,8,0">
        <TextBlock Text="Note selected file" Foreground="#8A8A84" FontSize="12" FontWeight="SemiBold" Margin="2,0,0,6"/>
        <Border x:Name="OpenBox" CornerRadius="10" Background="White" BorderBrush="#ECECE6" BorderThickness="1.5"
                Padding="12,10" Cursor="Hand" MouseLeftButtonUp="OpenBox_Click" Focusable="True" KeyDown="Box_KeyDown">
          <TextBlock x:Name="OpenBoxText" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center"/>
        </Border>
      </StackPanel>
      <StackPanel Grid.Column="1" Margin="8,0,0,0">
        <TextBlock Text="Search notes" Foreground="#8A8A84" FontSize="12" FontWeight="SemiBold" Margin="2,0,0,6"/>
        <Border x:Name="SearchBoxCap" CornerRadius="10" Background="White" BorderBrush="#ECECE6" BorderThickness="1.5"
                Padding="12,10" Cursor="Hand" MouseLeftButtonUp="SearchBox_Click" Focusable="True" KeyDown="Box_KeyDown">
          <TextBlock x:Name="SearchBoxText" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center"/>
        </Border>
      </StackPanel>
    </Grid>

    <!-- Explorer badges (opt-in, one-time admin registration) -->
    <TextBlock Grid.Row="3" Text="Explorer badges" FontSize="16" FontWeight="SemiBold" Margin="2,22,0,4"/>
    <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,0,0,4">
      <Button x:Name="BadgeButton" Content="Show badges in Explorer" Click="Badge_Click" Padding="14,7"
              Margin="0,0,8,0" Background="White" BorderBrush="#DDDDD6" Cursor="Hand"/>
      <Button x:Name="BadgeOffButton" Content="Turn off" Click="BadgeOff_Click" Padding="14,7"
              Background="White" BorderBrush="#DDDDD6" Cursor="Hand" Visibility="Collapsed"/>
    </StackPanel>
    <TextBlock Grid.Row="5" x:Name="BadgeStatusText" Margin="2,2,0,0" FontSize="12" Foreground="#8A8A84"
               TextWrapping="Wrap" VerticalAlignment="Top"/>

    <!-- Updates (Velopack, 0.8.0+) -->
    <TextBlock Grid.Row="6" Text="Updates" FontSize="16" FontWeight="SemiBold" Margin="2,22,0,4"/>
    <StackPanel Grid.Row="7" Orientation="Horizontal" Margin="0,0,0,4">
      <Button Content="Check for Updates…" Click="Updates_Click" Padding="14,7"
              Margin="0,0,10,0" Background="White" BorderBrush="#DDDDD6" Cursor="Hand"/>
      <TextBlock x:Name="UpdateStatusText" FontSize="12" Foreground="#8A8A84"
                 VerticalAlignment="Center" TextWrapping="Wrap"/>
    </StackPanel>

    <TextBlock Grid.Row="8" x:Name="StatusText" Margin="2,10,0,0" FontSize="12" Foreground="#8A8A84"
               TextWrapping="Wrap" VerticalAlignment="Top"/>

    <StackPanel Grid.Row="9" Orientation="Horizontal">
      <Button Content="Save" Click="Save_Click" Padding="16,7" Margin="0,0,8,0"
              Background="#EB961E" Foreground="White" FontWeight="SemiBold" Cursor="Hand"/>
      <Button Content="Reset to defaults" Click="Reset_Click" Padding="16,7" Margin="0,0,8,0"
              Background="White" BorderBrush="#DDDDD6" Cursor="Hand"/>
      <Button Content="Close" Click="Close_Click" Padding="16,7"
              Background="White" BorderBrush="#DDDDD6" Cursor="Hand"/>
    </StackPanel>
  </Grid>
</Window>
