<Window x:Class="FileLore.App.BatchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="640" Height="640" MinWidth="520" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Background="#FAFAF8" FontFamily="Segoe UI" FontSize="13"
        Title="Batch notes — FileLore">
  <Window.Resources>
    <Style x:Key="BaseButton" TargetType="Button">
      <Setter Property="Padding" Value="14,7"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter Property="Opacity" Value="0.85"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="AccentBtn" TargetType="Button" BasedOn="{StaticResource BaseButton}">
      <Setter Property="Background" Value="#EB961E"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
  </Window.Resources>

  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="160"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <TextBlock Grid.Row="0" x:Name="HeaderText" FontSize="16" FontWeight="SemiBold" Margin="2,0,0,10"/>

    <!-- File list -->
    <Border Grid.Row="1" CornerRadius="10" Background="White" BorderBrush="#ECECE6" BorderThickness="1">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <ItemsControl x:Name="FileList" Margin="6">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Grid Margin="4,3">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Mark}" Foreground="{Binding MarkColor}" FontWeight="Bold"
                           Width="20" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1">
                  <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12.5"/>
                  <TextBlock Text="{Binding Folder}" Foreground="#8A8A84" FontSize="11.5"
                             TextTrimming="CharacterEllipsis"/>
                </StackPanel>
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Border>

    <!-- Note body + mode -->
    <Grid Grid.Row="2" Margin="0,14,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock Text="Note body" Foreground="#8A8A84" FontSize="12" FontWeight="SemiBold" Margin="2,0,0,6"/>
        <Border CornerRadius="10" Background="White" BorderBrush="#ECECE6" BorderThickness="1">
          <TextBox x:Name="BodyBox" AcceptsReturn="True" TextWrapping="Wrap" Height="64"
                   VerticalScrollBarVisibility="Auto" BorderThickness="0" Background="Transparent"
                   Padding="10" FontSize="13" VerticalContentAlignment="Top"/>
        </Border>
      </StackPanel>
      <StackPanel Grid.Column="1" Margin="14,22,2,0" VerticalAlignment="Top">
        <RadioButton x:Name="BodySet" Content="Set" IsChecked="True" Margin="0,0,0,6"/>
        <RadioButton Content="Append"/>
      </StackPanel>
    </Grid>

    <!-- Tags + mode -->
    <Grid Grid.Row="3" Margin="0,12,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock Text="Tags (comma separated)" Foreground="#8A8A84" FontSize="12" FontWeight="SemiBold" Margin="2,0,0,6"/>
        <Border CornerRadius="10" Background="White" BorderBrush="#ECECE6" BorderThickness="1">
          <TextBox x:Name="TagsBox" BorderThickness="0" Background="Transparent" Padding="10,7" FontSize="13"/>
        </Border>
      </StackPanel>
      <StackPanel Grid.Column="1" Margin="14,22,2,0" VerticalAlignment="Top">
        <RadioButton x:Name="TagsAdd" Content="Add" IsChecked="True" Margin="0,0,0,6"/>
        <RadioButton Content="Replace"/>
      </StackPanel>
    </Grid>

    <TextBlock Grid.Row="4" Margin="2,8,0,0" FontSize="11.5" Foreground="#B0B0A8"
               Text="Empty body / tags fields leave that part of every note untouched."/>

    <!-- Per-file results -->
    <Border Grid.Row="5" CornerRadius="10" Background="White" BorderBrush="#ECECE6" BorderThickness="1" Margin="0,10,0,0">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel x:Name="ResultsPanel" Margin="10,8"/>
      </ScrollViewer>
    </Border>

    <!-- Actions + summary -->
    <DockPanel Grid.Row="6" Margin="0,14,0,0">
      <Button x:Name="ApplyBtn" Content="Apply to all files" Style="{StaticResource AccentBtn}"
              DockPanel.Dock="Right" Click="Apply_Click"/>
      <TextBlock x:Name="SummaryText" VerticalAlignment="Center" FontSize="12.5" Foreground="#8A8A84" TextWrapping="Wrap"/>
    </DockPanel>
  </Grid>
</Window>
