<Window x:Class="FileLore.App.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="460" SizeToContent="Height"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="#FDF7EC" FontFamily="Segoe UI" FontSize="13"
        Icon="pack://application:,,,/Resources/icon-256.png"
        Title="FileLore — Updates">
  <Border Margin="18" CornerRadius="16" BorderBrush="#F2E3C6" BorderThickness="1">
    <Border.Background>
      <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFFFFF" Offset="0"/>
        <GradientStop Color="#FDF3E3" Offset="1"/>
      </LinearGradientBrush>
    </Border.Background>
    <Border.Effect>
      <DropShadowEffect Color="#000000" Opacity="0.18" BlurRadius="18" ShadowDepth="3" Direction="270"/>
    </Border.Effect>

    <StackPanel Margin="28,24,28,22">
      <StackPanel Orientation="Horizontal">
        <Image Source="pack://application:,,,/Resources/icon-256.png" Width="34" Height="34" Margin="0,0,12,0"/>
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="FileLore Updates" FontSize="17" FontWeight="SemiBold" Foreground="#171208"/>
          <TextBlock x:Name="VersionText" FontSize="11.5" Foreground="#8A8A84"/>
        </StackPanel>
      </StackPanel>

      <TextBlock x:Name="MessageText" Margin="2,18,2,0" FontSize="13" Foreground="#444444"
                 TextWrapping="Wrap" Text="Checking for updates…"/>

      <ProgressBar x:Name="DownloadBar" Margin="2,14,2,0" Height="8" Minimum="0" Maximum="100"
                   Foreground="#EB961E" Background="#F2E3C6" BorderThickness="0"
                   Visibility="Collapsed"/>

      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
        <Button x:Name="ActionButton" Content="Restart now" Click="Action_Click" Padding="18,7"
                Margin="0,0,8,0" Background="#EB961E" Foreground="White" FontWeight="SemiBold"
                Cursor="Hand" Visibility="Collapsed"/>
        <Button x:Name="CloseButton" Content="Close" Click="Close_Click" Padding="18,7"
                Background="White" BorderBrush="#DDDDD6" Cursor="Hand"/>
      </StackPanel>
    </StackPanel>
  </Border>
</Window>
