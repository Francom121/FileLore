<Window x:Class="FileLore.App.ShortcutsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="520" Height="520" MinWidth="420" MinHeight="380"
        WindowStartupLocation="CenterScreen"
        Background="#FAFAF8" FontFamily="Segoe UI" FontSize="13"
        Title="Keyboard Shortcuts — FileLore">
  <Grid Margin="22">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <TextBlock Grid.Row="0" Text="Keyboard shortcuts" FontSize="16" FontWeight="SemiBold" Margin="2,0,0,12"/>

    <Border Grid.Row="1" CornerRadius="10" Background="White" BorderBrush="#ECECE6" BorderThickness="1">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <ItemsControl x:Name="List" Margin="14,10">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Grid Margin="0,5">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="140"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Background="#F2F2EE" CornerRadius="6" Padding="8,3" HorizontalAlignment="Left">
                  <TextBlock Text="{Binding Combo}" FontSize="12" FontWeight="SemiBold"/>
                </Border>
                <TextBlock Grid.Column="1" Text="{Binding Description}" FontSize="12.5"
                           Foreground="#555550" VerticalAlignment="Center" TextWrapping="Wrap"/>
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Border>

    <Button Grid.Row="2" Content="Close" Click="Close_Click" Padding="16,7" Margin="0,14,0,0"
            Background="White" BorderBrush="#DDDDD6" Cursor="Hand" HorizontalAlignment="Right"/>
  </Grid>
</Window>
